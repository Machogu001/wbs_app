<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme overrides. Brand navy header keeps its own fixed gradient
         (brand_navy / brand_navy_dark, inherited unchanged from values/colors.xml)
         so the header stays a clearly distinguishable, brighter navy against
         the deep near-black page background below. -->

    <!-- Solid brand tones used for filled buttons/paired-with-white-text
         controls stay saturated enough for white text; the "*_dark" aliases
         are the tokens read on top of tinted surfaces, so those are lightened
         here for contrast against the now-dark tint backgrounds. -->
    <color name="brand_primary_dark">#8FC3FF</color>
    <color name="brand_accent">#2DD4BF</color>
    <color name="brand_accent_dark">#5EEAD4</color>
    <color name="brand_amber">#E0A639</color>
    <color name="brand_amber_dark">#F2B33D</color>
    <color name="brand_red">#FF6F61</color>
    <color name="brand_red_dark">#FF9686</color>

    <!-- Surfaces: deep near-black/navy background with elevated dark cards. -->
    <color name="page_background">#0B1220</color>
    <color name="surface_card">#161D2E</color>
    <color name="surface_card_muted">#101728</color>
    <color name="surface_tint_blue">#16233E</color>
    <color name="surface_tint_teal">#12332E</color>
    <color name="surface_tint_amber">#3A2A12</color>
    <color name="surface_tint_red">#3A1817</color>
    <color name="surface_tint_navy">#141B2C</color>

    <!-- Text and lines -->
    <color name="body_text">#EDF1F8</color>
    <color name="muted_text">#9AA8C0</color>
    <color name="border">#28324A</color>
    <color name="progress_track">#232D45</color>
</resources>
